(* Comparison model: ML-KEM and ML-DSA remain ideal primitives after the
   explicit Shor oracle has broken only classical primitives. *)
free c: channel.
free welcome_ad: bitstring.
free transcript: bitstring.
free protected_value: bitstring [private].
event Committed(bitstring).
event Signed(bitstring).
event Accepted(bitstring).
query attacker(protected_value).
query message: bitstring; inj-event(Accepted(message)) ==> inj-event(Signed(message)).
query message: bitstring; inj-event(Accepted(message)) ==> inj-event(Committed(message)).
process
  new kem_sk: kem_sk;
  new signing_sk: sig_sk;
  new coins: bitstring;
  let kem_pk = mlkem_public(kem_sk) in
  let signing_pk = mldsa_public(signing_sk) in
  let welcome_key = mlkem_shared(kem_pk, coins) in
  event Committed(transcript);
  event Signed(transcript);
  out(c, (kem_pk, signing_pk, mlkem_encaps(kem_pk, coins),
          welcome_encrypt(welcome_key, protected_value, welcome_ad), mldsa_sign(transcript, signing_sk))) |
  in(c, candidate: signature);
  let message = mldsa_verify(candidate, signing_pk) in event Accepted(message)
